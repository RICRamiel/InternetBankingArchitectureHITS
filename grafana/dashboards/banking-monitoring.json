          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  trace_id,\n  min(\"time\") AS started_at,\n  count(*) AS spans,\n  count(DISTINCT service_name) AS services,\n  string_agg(DISTINCT service_name, ', ' ORDER BY service_name) AS service_chain,\n  max(duration_ms) AS max_span_ms,\n  sum(duration_ms) AS total_duration_ms,\n  count(*) FILTER (WHERE is_error) AS errors\nFROM metrics\nWHERE $__timeFilter((\"time\" AT TIME ZONE 'Asia/Tomsk')) AND trace_id IS NOT NULL\nGROUP BY trace_id\nORDER BY started_at DESC\nLIMIT 30;",
          "refId": "A"
