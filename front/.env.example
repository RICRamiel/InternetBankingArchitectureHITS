BFF_ORIGIN=http://127.0.0.1:8009

# Публичный URL dev-сервера (vite) за nginx/туннелем — HMR тогда идёт на этот хост, а не на localhost.
# Пример: DEV_PUBLIC_ORIGIN=https://admin.example.com
DEV_PUBLIC_ORIGIN=

# FCM: переменные VITE_FIREBASE_* задаются в apps/user/.env.example и apps/admin/.env.example
# (копия в .env рядом с приложением). Service worker public/firebase-messaging-sw.js должен
# содержать тот же firebaseConfig, что и эти переменные.
