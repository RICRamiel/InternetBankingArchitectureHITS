# Прокси Vite → BFF (см. корневой .env)
BFF_ORIGIN=http://127.0.0.1:8009

# Публичный origin, с которого открываете это приложение в dev (vite HMR / @vite/client).
# Пример: DEV_PUBLIC_ORIGIN=https://admin.example.com
DEV_PUBLIC_ORIGIN=

# Firebase Web App (можно отдельное приложение в том же проекте, что и user)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_FIREBASE_VAPID_KEY=
